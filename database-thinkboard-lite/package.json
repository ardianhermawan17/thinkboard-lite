{
  "devDependencies": {
    "supabase": "^2.117.0"
  },
  "scripts": {
    "start": "supabase start -x imgproxy,studio,postgres-meta,edge-runtime,logflare,vector,supavisor,mailpit",
    "stop": "supabase stop",
    "reset": "supabase db reset",
    "db:seed": "supabase db reset && node supabase/seed/upload-pdf.mjs",
    "test": "node --test \"supabase/tests/*.test.mjs\"",
    "test:seed": "node --test --test-concurrency=1 \"supabase/tests/seed/*.test.mjs\""
  }
}
